# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
tfplan

# Variable files may contain account-specific or sensitive values
*.tfvars
*.tfvars.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Editor and IDE metadata
.vscode/
.idea/

# Operating system metadata
.DS_Store
Thumbs.db

# Keep the dependency lock file in source control
!.terraform.lock.hcl
